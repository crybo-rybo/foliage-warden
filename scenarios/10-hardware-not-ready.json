{
  "schema_version": 1,
  "scenario_id": "hardware-not-ready-v1",
  "title": "Actuator not ready blocks an otherwise valid event",
  "description": "The mock actuator reports NOT_READY before arming. Persistent eating evidence may be recognized, but hardware readiness is a mandatory final interlock and no command may be emitted.",
  "requirement_ids": ["REQ-HARDWARE-READY-INTERLOCK", "REQ-FAIL-CLOSED"],
  "tags": ["safety", "actuator", "not-ready", "fault-injection"],
  "config_ref": "../config/simulation-safe.example.json",
  "initial_conditions": {
    "clock_ms": 0,
    "policy_state": "DISARMED",
    "armed": false,
    "camera_status": "CONNECTED",
    "actuator_status": "NOT_READY",
    "command_id_seed": 1900
  },
  "actuator_script": {
    "default_response": "ACK",
    "ack_delay_ms": 20,
    "deduplicate_command_ids": true,
    "overrides": []
  },
  "timeline": [
    {"event_id": "arm", "at_ms": 0, "sequence": 0, "type": "CONTROL", "operation": "ARM"},
    {
      "event_id": "eating-while-not-ready",
      "at_ms": 100,
      "sequence": 0,
      "type": "OBSERVATION_SERIES",
      "interval_ms": 400,
      "count": 5,
      "capture_offset_ms": 0,
      "id_prefix": "not-ready-eating",
      "template": {
        "camera_id": "camera-1",
        "tracks": [
          {
            "track_id": "cat-a",
            "class": "CAT",
            "detection_confidence": 0.98,
            "track_quality": 0.95,
            "initial_track_age_ms": 900,
            "ambiguous": false,
            "bbox": {"x": 0.36, "y": 0.28, "width": 0.34, "height": 0.44},
            "zone_id": "pot-1-approach",
            "behavior": {
              "label": "EATING",
              "raw_label": "EATING",
              "scores": {"CLEAR": 0.02, "EATING": 0.94, "DIGGING": 0.01, "UNKNOWN": 0.03},
              "model_id": "scripted-behavior-v1"
            },
            "region_evidence": {
              "approach_overlap": 0.91,
              "foliage_overlap": 0.59,
              "soil_overlap": 0.04,
              "motion_score": 0.4
            },
            "aim_preset_id": "pot-1-safe-nearby",
            "no_fire_intersection": false
          }
        ]
      }
    }
  ],
  "expectations": {
    "explanation": "The unavailable actuator blocks readiness and is recorded as HARDWARE_NOT_READY; it is not treated as permission to shadow-dispatch a command.",
    "final_state": "MONITORING",
    "exact_counts": {
      "ready_transitions": 0,
      "would_burst_decisions": 0,
      "burst_commands_issued": 0,
      "burst_commands_acked": 0,
      "physical_bursts": 0,
      "automatic_retries": 0,
      "duplicate_commands_suppressed": 0,
      "fault_transitions": 0
    },
    "required_states": ["MONITORING"],
    "forbidden_states": ["AIMING", "READY", "BURST"],
    "required_reason_codes": ["HARDWARE_NOT_READY"],
    "forbidden_commands": ["GOTO_PRESET", "BURST"],
    "expected_action_sequence": [],
    "invariants": ["STARTS_DISARMED", "NO_PHYSICAL_EFFECTS", "HARDWARE_NOT_READY_BLOCKS_ACTION", "ACTIONS_AUDITED", "DETERMINISTIC_REPLAY"]
  }
}
