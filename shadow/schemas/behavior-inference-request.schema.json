{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foliage-warden.local/shadow/behavior-inference-request.schema.json",
  "title": "Offline temporal behavior inference request",
  "description": "One strict, deterministic request binding a pre-extracted RGB NumPy clip to an exact perception observation, frame, cat track, capture timestamp, and replay delivery timestamp.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "sequence",
    "observation_id",
    "frame_id",
    "track_id",
    "captured_at_ms",
    "predicted_at_ms",
    "clip"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "record_type": {"const": "behavior_inference_request"},
    "sequence": {"$ref": "#/$defs/non_negative_safe_integer"},
    "observation_id": {"$ref": "#/$defs/identifier"},
    "frame_id": {"$ref": "#/$defs/identifier"},
    "track_id": {"$ref": "#/$defs/identifier"},
    "captured_at_ms": {"$ref": "#/$defs/non_negative_safe_integer"},
    "predicted_at_ms": {"$ref": "#/$defs/non_negative_safe_integer"},
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "frame_timestamps_ms",
        "path",
        "sha256",
        "window_end_captured_at_ms",
        "window_start_captured_at_ms"
      ],
      "properties": {
        "format": {"const": "NUMPY_RGB_UINT8_THWC"},
        "frame_timestamps_ms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/non_negative_safe_integer"}
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"$ref": "#/$defs/sha256"},
        "window_end_captured_at_ms": {"$ref": "#/$defs/non_negative_safe_integer"},
        "window_start_captured_at_ms": {"$ref": "#/$defs/non_negative_safe_integer"}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "non_negative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
