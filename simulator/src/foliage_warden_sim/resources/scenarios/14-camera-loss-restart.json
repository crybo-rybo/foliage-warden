{
  "schema_version": 1,
  "scenario_id": "camera-loss-restart-v1",
  "title": "Camera loss faults and restart stays disarmed",
  "description": "An armed simulation loses its camera long enough to exceed the one-second timeout and enters FAULT. A process restart resets all volatile state to DISARMED; reconnecting the camera and receiving strong eating evidence cannot re-arm it.",
  "requirement_ids": ["REQ-CAMERA-LOSS-FAIL-CLOSED", "REQ-RESTART-REQUIRES-REARM", "REQ-STARTUP-DISARMED"],
  "tags": ["safety", "camera-loss", "restart", "fault-injection"],
  "config_ref": "../config/simulation-safe.example.json",
  "initial_conditions": {
    "clock_ms": 0,
    "policy_state": "DISARMED",
    "armed": false,
    "camera_status": "CONNECTED",
    "actuator_status": "READY",
    "command_id_seed": 2300
  },
  "actuator_script": {
    "default_response": "ACK",
    "ack_delay_ms": 20,
    "deduplicate_command_ids": true,
    "overrides": []
  },
  "timeline": [
    {"event_id": "arm", "at_ms": 0, "sequence": 0, "type": "CONTROL", "operation": "ARM"},
    {
      "event_id": "camera-unplugged",
      "at_ms": 100,
      "sequence": 0,
      "type": "CAMERA_STATUS",
      "status": "DISCONNECTED",
      "reason": "Injected cable removal."
    },
    {"event_id": "camera-timeout", "at_ms": 1200, "sequence": 0, "type": "TICK"},
    {"event_id": "restart", "at_ms": 1500, "sequence": 0, "type": "PROCESS_RESTART", "restart_id": "restart-1"},
    {"event_id": "camera-reconnected", "at_ms": 1600, "sequence": 0, "type": "CAMERA_STATUS", "status": "CONNECTED"},
    {
      "event_id": "post-restart-eating",
      "at_ms": 1700,
      "sequence": 0,
      "type": "OBSERVATION_SERIES",
      "interval_ms": 400,
      "count": 5,
      "capture_offset_ms": 0,
      "id_prefix": "post-restart-eating",
      "template": {
        "camera_id": "camera-1",
        "tracks": [
          {
            "track_id": "cat-a",
            "class": "CAT",
            "detection_confidence": 0.98,
            "track_quality": 0.95,
            "initial_track_age_ms": 900,
            "ambiguous": false,
            "bbox": {"x": 0.36, "y": 0.28, "width": 0.34, "height": 0.44},
            "zone_id": "pot-1-approach",
            "behavior": {
              "label": "EATING",
              "raw_label": "EATING",
              "scores": {"CLEAR": 0.02, "EATING": 0.94, "DIGGING": 0.01, "UNKNOWN": 0.03},
              "model_id": "scripted-behavior-v1"
            },
            "region_evidence": {
              "approach_overlap": 0.91,
              "foliage_overlap": 0.59,
              "soil_overlap": 0.04,
              "motion_score": 0.4
            },
            "aim_preset_id": "pot-1-safe-nearby",
            "no_fire_intersection": false
          }
        ]
      }
    },
    {"event_id": "end-of-run", "at_ms": 3500, "sequence": 0, "type": "TICK"}
  ],
  "expectations": {
    "explanation": "The camera timeout creates one fault. Restart is a fresh startup boundary, so the final state remains DISARMED despite healthy inputs and action-worthy observations.",
    "final_state": "DISARMED",
    "exact_counts": {
      "ready_transitions": 0,
      "would_burst_decisions": 0,
      "burst_commands_issued": 0,
      "burst_commands_acked": 0,
      "physical_bursts": 0,
      "automatic_retries": 0,
      "duplicate_commands_suppressed": 0,
      "fault_transitions": 1
    },
    "required_states": ["MONITORING", "FAULT", "DISARMED"],
    "forbidden_states": ["AIMING", "READY", "BURST"],
    "required_reason_codes": ["CAMERA_DISCONNECTED", "CAMERA_TIMEOUT", "PROCESS_RESTART", "STARTUP_DISARMED"],
    "forbidden_commands": ["GOTO_PRESET", "BURST"],
    "expected_action_sequence": [],
    "invariants": ["STARTS_DISARMED", "NO_PHYSICAL_EFFECTS", "RESTART_REQUIRES_REARM", "ACTIONS_AUDITED", "DETERMINISTIC_REPLAY"]
  }
}
